<Window x:Class="VO1D.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:VO1D.Desktop"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="VO1D" Width="1380" Height="860" MinWidth="1080" MinHeight="680"
 WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#050505"
 Foreground="White" FontFamily="{StaticResource UiFont}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource RoundIconButton}">
      <Setter Property="Width" Value="48"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Margin" Value="0,5"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style x:Key="RoomItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.Background>
      <RadialGradientBrush Center="0.12,0.04" GradientOrigin="0.12,0.04" RadiusX="1.2" RadiusY="1.1">
        <GradientStop Color="#151515" Offset="0"/>
        <GradientStop Color="#080808" Offset="0.38"/>
        <GradientStop Color="#030303" Offset="1"/>
      </RadialGradientBrush>
    </Grid.Background>

    <Ellipse Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-320,0,0" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#18FFFFFF" Offset="0"/>
          <GradientStop Color="#00FFFFFF" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Ellipse Width="500" Height="500" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-260,-280" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#0EFFFFFF" Offset="0"/>
          <GradientStop Color="#00FFFFFF" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <!-- custom title bar -->
    <Grid Height="38" VerticalAlignment="Top" Background="#01000000" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <TextBlock Text="VO1D / DESKTOP" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="#7FFFFFFF"
                 VerticalAlignment="Center" Margin="18,0,0,0" CharacterSpacing="220"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="MinButton" Width="46" Height="38" Content="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="11"
                Background="Transparent" Foreground="#BFFFFFFF" BorderThickness="0" Click="Minimize_Click"/>
        <Button x:Name="MaxButton" Width="46" Height="38" Content="&#xE922;" FontFamily="Segoe Fluent Icons" FontSize="11"
                Background="Transparent" Foreground="#BFFFFFFF" BorderThickness="0" Click="Maximize_Click"/>
        <Button x:Name="CloseButton" Width="46" Height="38" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="11"
                Background="Transparent" Foreground="#BFFFFFFF" BorderThickness="0" Click="Close_Click"/>
      </StackPanel>
    </Grid>

    <!-- MAIN SHELL -->
    <Grid x:Name="MainShell" Margin="16,48,16,16" Opacity="0" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform><ScaleTransform x:Name="MainScale" ScaleX="0.985" ScaleY="0.985"/></Grid.RenderTransform>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="78"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="390"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- NAV -->
      <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="10" CornerRadius="28">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <local:BrandMark Width="48" Height="48" HorizontalAlignment="Center" Margin="0,4,0,12"/>
          <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <Button x:Name="ChatsNav" Style="{StaticResource NavButton}" Content="&#xE8BD;" ToolTip="Чаты" Click="ChatsNav_Click"/>
            <Button x:Name="PeopleNav" Style="{StaticResource NavButton}" Content="&#xE716;" ToolTip="Люди" Click="PeopleNav_Click"/>
            <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Content="&#xE713;" ToolTip="Настройки" Click="SettingsNav_Click"/>
          </StackPanel>
          <StackPanel Grid.Row="2" HorizontalAlignment="Center">
            <Ellipse x:Name="RelayDot" Width="7" Height="7" Fill="#78FFFFFF" Margin="0,0,0,10"/>
            <Border Width="42" Height="42" CornerRadius="15" Background="#12FFFFFF" BorderBrush="#1BFFFFFF" BorderThickness="1">
              <TextBlock x:Name="MiniInitial" Text="V" FontWeight="Black" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- CHAT LIST -->
      <Border x:Name="RoomsPane" Grid.Column="2" Style="{StaticResource GlassCard}" Padding="20" CornerRadius="28">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <local:BrandMark Width="28" Height="28" Margin="0,0,9,0"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="VO1D" FontFamily="{StaticResource MonoFont}" FontWeight="Black" FontSize="14" CharacterSpacing="350"/>
                  <TextBlock Text="MESSENGER" FontFamily="{StaticResource MonoFont}" Foreground="#86FFFFFF" FontSize="7" CharacterSpacing="220"/>
                </StackPanel>
              </StackPanel>
              <TextBlock Text="Сообщения" FontSize="34" FontWeight="Black" Margin="0,17,0,0" CharacterSpacing="-25"/>
            </StackPanel>
            <Button Style="{StaticResource RoundIconButton}" Content="&#xE710;" Background="White" Foreground="Black"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="50" Height="50" Click="OpenAddContact_Click"/>
          </Grid>

          <Grid Grid.Row="1" Margin="2,15,2,13">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xEA18;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#A8FFFFFF" VerticalAlignment="Center"/>
              <TextBlock x:Name="ConnectionText" Text="ПОДКЛЮЧЕНИЕ…" FontFamily="{StaticResource MonoFont}" FontSize="9" FontWeight="SemiBold"
                         Foreground="#A8FFFFFF" Margin="8,0,0,0" VerticalAlignment="Center" CharacterSpacing="120"/>
            </StackPanel>
            <TextBlock x:Name="QueueText" Text="E2EE" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}"
                       FontSize="9" Foreground="#78FFFFFF" CharacterSpacing="120"/>
          </Grid>

          <Grid Grid.Row="2">
            <TextBox x:Name="SearchBox" Style="{StaticResource VoidTextBox}" Height="48" Padding="42,0,14,0"
                     VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#82FFFFFF"
                       Margin="15,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBlock x:Name="SearchHint" Text="Найти чат или сообщение" Foreground="#68FFFFFF" Margin="42,0,0,0"
                       VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>

          <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,12,0,10">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="AllChip" Style="{StaticResource ChipButton}" Content="ВСЕ" Background="White" Foreground="Black" Margin="0,0,7,0"/>
              <Button Style="{StaticResource ChipButton}" Content="НЕПРОЧИТАННЫЕ" Margin="0,0,7,0"/>
              <Button Style="{StaticResource ChipButton}" Content="ЛИЧНЫЕ" Margin="0,0,7,0"/>
              <Button Style="{StaticResource ChipButton}" Content="ГРУППЫ" Margin="0,0,7,0"/>
              <Button Style="{StaticResource ChipButton}" Content="АРХИВ"/>
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="4">
            <ListBox x:Name="RoomList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource RoomItem}" SelectionChanged="RoomList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="Card" CornerRadius="22" Padding="13" Margin="0,0,0,10" Background="#B50D0D0D"
                          BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Width="52" Height="52" CornerRadius="18" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                        <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <Grid Grid.Column="1" Margin="13,0,0,0">
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <Grid>
                          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Time}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="#78FFFFFF"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,7,0,0">
                          <TextBlock Text="{Binding Preview}" Foreground="#8FFFFFFF" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,34,0"/>
                          <Border x:Name="UnreadBadge" Width="24" Height="24" CornerRadius="12" Background="White" HorizontalAlignment="Right"
                                  Visibility="{Binding UnreadVisibility}">
                            <TextBlock Text="{Binding Unread}" Foreground="Black" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                        </Grid>
                      </Grid>
                    </Grid>
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#B50D0D0D"/>
                        <Style.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EE181818"/></Trigger>
                          <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                            <Setter Property="Background" Value="#F21D1D1D"/>
                            <Setter Property="BorderBrush" Value="#43FFFFFF"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Border x:Name="EmptyRooms" Style="{StaticResource GlassCard}" Padding="24" VerticalAlignment="Center" Visibility="Collapsed">
              <StackPanel HorizontalAlignment="Center">
                <local:BrandMark Width="76" Height="76" Margin="0,0,0,15"/>
                <TextBlock Text="Здесь пока тихо." FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Добавь человека по VO1D ID или @username." Foreground="#8FFFFFFF" TextAlignment="Center" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </Grid>

          <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#72FFFFFF" Margin="0,0,7,0"/>
            <TextBlock Text="E2EE · ЗАШИФРОВАНО НА УСТРОЙСТВЕ" FontFamily="{StaticResource MonoFont}" FontSize="8" Foreground="#72FFFFFF" CharacterSpacing="90"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- RIGHT WORKSPACES -->
      <Grid Grid.Column="4">
        <Border x:Name="ChatWorkspace" Style="{StaticResource GlassCard}" Padding="0" CornerRadius="28" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="82"/></Grid.RowDefinitions>

            <Border BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="20,14">
              <Grid>
                <StackPanel Orientation="Horizontal">
                  <Border x:Name="ChatAvatar" Width="50" Height="50" CornerRadius="17" Background="#14FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1">
                    <TextBlock x:Name="ChatInitial" Text="V" FontWeight="Black" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Margin="13,4,0,0">
                    <TextBlock x:Name="ChatTitle" Text="VO1D Desktop" FontWeight="Bold" FontSize="17"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                      <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#8FFFFFFF" Margin="0,0,6,0"/>
                      <TextBlock Text="E2EE · PRIVATE CHANNEL" FontFamily="{StaticResource MonoFont}" FontSize="8" Foreground="#8FFFFFFF" CharacterSpacing="120"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Style="{StaticResource RoundIconButton}" Content="&#xE721;" Margin="0,0,8,0"/>
                  <Button Style="{StaticResource RoundIconButton}" Content="&#xE717;" Margin="0,0,8,0"/>
                  <Button Style="{StaticResource RoundIconButton}" Content="&#xE946;"/>
                </StackPanel>
              </Grid>
            </Border>

            <Grid Grid.Row="1">
              <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <ItemsControl x:Name="MessageList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,4">
                        <Border x:Name="Bubble" MaxWidth="620" CornerRadius="21" Padding="14,11" HorizontalAlignment="Left"
                                Background="#F0151515" BorderBrush="#18FFFFFF" BorderThickness="1">
                          <StackPanel>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14.5"/>
                            <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="8" Foreground="#72FFFFFF"
                                       HorizontalAlignment="Right" Margin="8,7,0,0"/>
                          </StackPanel>
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="HorizontalAlignment" Value="Left"/>
                              <Setter Property="Background" Value="#F0151515"/>
                              <Setter Property="TextElement.Foreground" Value="White"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Mine}" Value="True">
                                  <Setter Property="HorizontalAlignment" Value="Right"/>
                                  <Setter Property="Background" Value="#FFE2E2EA"/>
                                  <Setter Property="TextElement.Foreground" Value="Black"/>
                                  <Setter Property="BorderBrush" Value="#10FFFFFF"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <StackPanel x:Name="NoChat" HorizontalAlignment="Center" VerticalAlignment="Center" Width="390">
                <local:BrandMark Width="112" Height="112" HorizontalAlignment="Center"/>
                <TextBlock Text="Тише сети. Ближе к своим." FontSize="27" FontWeight="Black" TextAlignment="Center" Margin="0,20,0,0"/>
                <TextBlock Text="Выбери разговор слева или добавь человека по 4-символьному VO1D ID." Foreground="#8FFFFFFF"
                           TextAlignment="Center" FontSize="13.5" LineHeight="21" Margin="0,10,0,0"/>
              </StackPanel>
            </Grid>

            <Border Grid.Row="2" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="16,13">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                <Button Style="{StaticResource RoundIconButton}" Content="&#xE710;" Width="42" Height="42" IsEnabled="False"/>
                <TextBox x:Name="ComposerBox" Grid.Column="1" Style="{StaticResource VoidTextBox}" Margin="10,0" VerticalContentAlignment="Center"
                         KeyDown="ComposerBox_KeyDown" IsEnabled="False"/>
                <Button Grid.Column="2" Style="{StaticResource RoundIconButton}" Content="&#xE720;" Width="42" Height="42" IsEnabled="False"/>
                <Button x:Name="SendButton" Grid.Column="3" Style="{StaticResource RoundIconButton}" Content="&#xE74A;" Width="42" Height="42"
                        Background="White" Foreground="Black" Click="Send_Click" IsEnabled="False"/>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <!-- PEOPLE -->
        <Border x:Name="PeopleWorkspace" Style="{StaticResource GlassCard}" Padding="28" CornerRadius="28" Visibility="Collapsed">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="Люди" FontSize="36" FontWeight="Black"/>
              <TextBlock Text="Проверенные контакты VO1D" Foreground="#8FFFFFFF" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Row="1" Style="{StaticResource PrimaryButton}" Content="+ ДОБАВИТЬ ЧЕЛОВЕКА" Width="230" HorizontalAlignment="Left"
                    Margin="0,22,0,18" Click="OpenAddContact_Click"/>
            <ListBox x:Name="PeopleList" Grid.Row="2" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource RoomItem}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource GlassCard}" Margin="0,0,0,10" Padding="16">
                    <StackPanel Orientation="Horizontal">
                      <Border Width="48" Height="48" CornerRadius="16" Background="#14FFFFFF">
                        <TextBlock Text="{Binding Initial}" FontSize="17" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Margin="14,4,0,0">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="{Binding Fingerprint}" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="#7FFFFFFF" Margin="0,6,0,0"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <!-- SETTINGS -->
        <Border x:Name="SettingsWorkspace" Style="{StaticResource GlassCard}" Padding="28" CornerRadius="28" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Настройки" FontSize="36" FontWeight="Black"/>
              <TextBlock Text="Приватность, сеть и локальное устройство" Foreground="#8FFFFFFF" Margin="0,5,0,22"/>

              <Border Style="{StaticResource GlassCard}" Margin="0,0,0,12">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="ЛИЧНОСТЬ" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="#7FFFFFFF" CharacterSpacing="160"/>
                    <TextBlock x:Name="SettingsCode" Text="----" FontFamily="{StaticResource MonoFont}" FontSize="30" FontWeight="Black" CharacterSpacing="220" Margin="0,10,0,0"/>
                    <TextBlock x:Name="SettingsFingerprint" Text="..." FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="#7FFFFFFF" Margin="0,8,0,0"/>
                  </StackPanel>
                  <local:BrandMark Grid.Column="1" Width="72" Height="72"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource GlassCard}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="СЕТЬ" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="#7FFFFFFF" CharacterSpacing="160"/>
                  <Grid Margin="0,15,0,0">
                    <StackPanel>
                      <TextBlock Text="Production relay" FontWeight="Bold"/>
                      <TextBlock Text="f-production-bdfe.up.railway.app" Foreground="#8FFFFFFF" FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#12FFFFFF" CornerRadius="14" Padding="12,7">
                      <TextBlock Text="HTTPS" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="#BFFFFFFF"/>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource GlassCard}">
                <StackPanel>
                  <TextBlock Text="WINDOWS BETA" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="#7FFFFFFF" CharacterSpacing="160"/>
                  <TextBlock Text="Desktop слой" FontWeight="Bold" FontSize="16" Margin="0,13,0,0"/>
                  <TextBlock Text="UI теперь повторяет визуальную систему iOS. Полный внутренний libsignal-v2 слой для iPhone ↔ Windows переносится отдельно — без небезопасного downgrade."
                             Foreground="#8FFFFFFF" TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <!-- ONBOARDING -->
    <Grid x:Name="OnboardingLayer" Background="#F7040404" Visibility="Collapsed" Panel.ZIndex="80">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="78" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <local:BrandMark Width="42" Height="42" Margin="0,0,12,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="VO1D" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="Black" CharacterSpacing="380"/>
            <TextBlock Text="MESSENGER" FontFamily="{StaticResource MonoFont}" FontSize="8" Foreground="#83FFFFFF" CharacterSpacing="220"/>
          </StackPanel>
        </StackPanel>
        <local:BrandMark Width="156" Height="156" Margin="0,55,0,38" HorizontalAlignment="Left"/>
        <TextBlock Text="Тише сети.&#x0a;Ближе к своим." FontSize="48" FontWeight="Black" CharacterSpacing="-35" LineHeight="51"/>
        <TextBlock Text="Без телефона и почты. Ключи создаются на устройстве. Desktop сохраняет тот же приватный характер интерфейса."
                   Foreground="#98FFFFFF" FontSize="14" TextWrapping="Wrap" Width="520" LineHeight="23" HorizontalAlignment="Left" Margin="0,18,0,0"/>
      </StackPanel>
      <Border Grid.Column="1" Style="{StaticResource GlassCard}" Width="470" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock Text="PRIVATE / E2EE" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="#84FFFFFF" CharacterSpacing="170"/>
          <TextBlock Text="Добро пожаловать." FontSize="30" FontWeight="Black" Margin="0,14,0,0"/>
          <TextBlock Text="Как тебя будут видеть в VO1D?" Foreground="#8FFFFFFF" Margin="0,7,0,22"/>
          <TextBox x:Name="NicknameBox" Style="{StaticResource VoidTextBox}" Height="54"/>
          <Border Style="{StaticResource GlassCard}" Margin="0,14,0,14" Padding="16">
            <Grid>
              <StackPanel>
                <TextBlock Text="МАРШРУТ" FontFamily="{StaticResource MonoFont}" FontSize="8" Foreground="#72FFFFFF" CharacterSpacing="130"/>
                <TextBlock Text="Production relay · HTTPS" FontWeight="SemiBold" Margin="0,7,0,0"/>
              </StackPanel>
              <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#BFFFFFFF"/>
            </Grid>
          </Border>
          <Button Style="{StaticResource PrimaryButton}" Content="ВОЙТИ В VO1D   ↗" Click="FinishOnboarding_Click"/>
          <TextBlock Text="Ключи хранятся локально и защищаются Windows DPAPI + AES-GCM." Foreground="#68FFFFFF" FontSize="10"
                     TextWrapping="Wrap" Margin="0,14,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ADD CONTACT MODAL -->
    <Grid x:Name="ModalLayer" Background="#B3000000" Visibility="Collapsed" Panel.ZIndex="90" MouseDown="ModalLayer_MouseDown">
      <Border x:Name="AddCard" Style="{StaticResource GlassCard}" Width="470" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
              MouseDown="AddCard_MouseDown" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform x:Name="AddCardScale" ScaleX="0.96" ScaleY="0.96"/></Border.RenderTransform>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <local:BrandMark Width="34" Height="34" Margin="0,0,11,0"/>
            <StackPanel>
              <TextBlock Text="НОВЫЙ КОНТАКТ" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="#7FFFFFFF" CharacterSpacing="160"/>
              <TextBlock Text="Найти человека" FontSize="25" FontWeight="Black" Margin="0,5,0,0"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Text="4-символьный VO1D ID, @username или полный fingerprint." Foreground="#8FFFFFFF" Margin="0,18,0,12"/>
          <TextBox x:Name="AddContactBox" Style="{StaticResource VoidTextBox}" Height="54"/>
          <TextBlock x:Name="AddError" Foreground="#E0FFFFFF" FontSize="11" Margin="2,10,0,0" Visibility="Collapsed"/>
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button Style="{StaticResource ChipButton}" Content="ОТМЕНА" Click="CloseModal_Click"/>
            <Button x:Name="AddContactButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="ДОБАВИТЬ" Click="AddContact_Click"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- SPLASH -->
    <Grid x:Name="SplashLayer" Background="#FF050505" Panel.ZIndex="100">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
        <StackPanel.RenderTransform><ScaleTransform x:Name="SplashScale" ScaleX="0.78" ScaleY="0.78"/></StackPanel.RenderTransform>
        <local:BrandMark Width="132" Height="132" HorizontalAlignment="Center"/>
        <TextBlock Text="VO1D" FontFamily="{StaticResource MonoFont}" FontSize="34" FontWeight="Black" CharacterSpacing="520"
                   HorizontalAlignment="Center" Margin="0,24,0,0"/>
        <TextBlock Text="PRIVATE MESSAGING LAYER" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="#83FFFFFF"
                   CharacterSpacing="190" HorizontalAlignment="Center" Margin="0,7,0,0"/>
        <Grid Width="180" Height="2" Margin="0,28,0,0" ClipToBounds="True">
          <Border Background="#18FFFFFF" CornerRadius="1"/>
          <Border x:Name="ScanLine" Width="50" Background="White" CornerRadius="1" HorizontalAlignment="Left">
            <Border.RenderTransform><TranslateTransform x:Name="ScanTransform" X="-60"/></Border.RenderTransform>
          </Border>
        </Grid>
      </StackPanel>
    </Grid>
  </Grid>
</Window>