<UserControl x:Class="VO1D.Desktop.BrandMark"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="Transparent">
  <Viewbox Stretch="Uniform">
    <Grid Width="100" Height="100">
      <Ellipse Fill="#06000000" Stroke="#24FFFFFF" StrokeThickness="1.6"/>
      <Path Stroke="White" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            Data="M 8,53 A 42,42 0 0 1 54,8" RenderTransformOrigin="0.5,0.5">
        <Path.RenderTransform><RotateTransform x:Name="ArcRotate1"/></Path.RenderTransform>
      </Path>
      <Path Stroke="#78FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            Data="M 92,47 A 42,42 0 0 1 46,92" RenderTransformOrigin="0.5,0.5">
        <Path.RenderTransform><RotateTransform x:Name="ArcRotate2"/></Path.RenderTransform>
      </Path>
      <Rectangle Width="45" Height="45" Stroke="#48FFFFFF" StrokeThickness="1.4"
                 RadiusX="7" RadiusY="7" RenderTransformOrigin="0.5,0.5">
        <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
      </Rectangle>
      <Ellipse Width="29" Height="29" Fill="#050505" Stroke="White" StrokeThickness="2"/>
      <Border Width="5.5" Height="23" Background="White" CornerRadius="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-3,0,0"/>
      <Ellipse Width="5.5" Height="5.5" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,20,0"/>
    </Grid>
  </Viewbox>
</UserControl>