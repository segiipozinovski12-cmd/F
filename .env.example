VO1D_DOMAIN=chat.example.com

# Set only exact CIDRs for your immediate trusted proxy network.
# Empty = ignore X-Forwarded-For. Never use 0.0.0.0/0 or ::/0.
VO1D_TRUSTED_PROXIES=

# Optional; used with compose.push.yaml. Keep the private key out of Git.
VO1D_APNS_KEY_ID=
VO1D_APNS_TEAM_ID=
VO1D_APNS_TOPIC=io.vo1d.messenger
VO1D_APNS_KEY_FILE=
